

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
 
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
  MEMBER
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  name        String?
  role        Role       @default(USER)
  feedbacks   Feedback[]
  clerkUserId String     @unique
}

model Feedback {
  id        String   @id @default(cuid())
  content   String
  source    String
  sentiment String
  category  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}